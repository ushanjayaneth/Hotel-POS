# Node 24+ branch hub. This file is a reference: pass environment variables in
# your service environment, or run Node/tsx with --env-file=.env.
HOST=0.0.0.0
PORT=3001
DATABASE_PATH=data/demo-hotel.sqlite

# Demo mode contains sample business data and public demonstration PINs.
# Set false and use a NEW DATABASE_PATH for an empty live database.
POS_DEMO_MODE=true
# INITIAL_ADMIN_PIN must be unique and 6–12 digits for the first non-demo run.
INITIAL_ADMIN_PIN=

# Serve the hub behind HTTPS on a real LAN/domain, then enable secure cookies.
COOKIE_SECURE=false
# Comma-separated exact trusted frontend origins, if using a separate frontend.
ALLOWED_ORIGINS=

# Cloud sync is optional and remains visibly pending until configured.
# A trusted HTTPS receiver must authenticate SYNC_TOKEN, validate branch access,
# deduplicate immutable events by event.id, persist to Firebase, then respond
# {"acceptedIds":["event-..."]} ONLY after durable storage. Never acknowledge
# an event before committing it. Keep SYNC_TOKEN out of browser code.
HUB_ID=colombo-hub
HUB_BRANCH_ID=b1
SYNC_ENDPOINT=
SYNC_TOKEN=
# Receiver-only Firebase origin. Never put this in VITE_* or frontend files.
FIREBASE_DATABASE_URL=

# Cloud receiver process only (npm run start:cloud). These values NEVER go into
# VITE_* variables or frontend bundles. Use a separate server/environment.
CLOUD_HOST=0.0.0.0
CLOUD_PORT=3002
CLOUD_TENANT_ID=demo-hotel
# Exactly one active hub per branch; use independently generated 32+ char secrets.
CLOUD_HUB_CREDENTIALS={"colombo-hub":{"branchId":"b1","token":"replace-with-a-unique-random-secret-32-plus-characters"}}
# Standard Google Admin SDK credential file path; backend process only.
GOOGLE_APPLICATION_CREDENTIALS=

# Vercel /api/cloud: server-only owner monitoring and shared online POS.
# Set these in Vercel Project Settings > Environment Variables, then redeploy.
# Never use VITE_ prefixes or commit the service-account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
CLOUD_OWNER_EMAIL=
# Prefer the scrypt value generated by scripts/create-cloud-config.mjs.
CLOUD_OWNER_PASSWORD_HASH=
# Optional alternative: a private server environment password, at least 12 chars.
CLOUD_OWNER_PASSWORD=
CLOUD_SESSION_SECRET=
